# Maintainer: funkypitt <pierregallaz@gmail.com>
# Arch / Manjaro: cd packaging && makepkg -si
pkgname=readers-notes
pkgver=1.1.0
pkgrel=1
pkgdesc="Black-and-white, plain-text notes synced with the phone over WebDAV (kDrive, Nextcloud…)"
arch=('any')
url="https://github.com/funkypitt/readers-notes-desktop"
license=('MIT')
depends=('python' 'python-pyqt5' 'python-requests')
source=("$pkgname-$pkgver.tar.gz::https://github.com/funkypitt/readers-notes-desktop/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

package() {
  cd "$srcdir/readers-notes-desktop-$pkgver"
  install -Dm755 readers_notes.py "$pkgdir/usr/lib/readers-notes/readers_notes.py"
  install -Dm755 /dev/stdin "$pkgdir/usr/bin/readers-notes" <<'SH'
#!/bin/sh
exec python3 /usr/lib/readers-notes/readers_notes.py "$@"
SH
  install -Dm644 packaging/readers-notes.desktop "$pkgdir/usr/share/applications/readers-notes.desktop"
  install -Dm644 packaging/readers-notes.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/readers-notes.svg"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
